@model IEnumerable<DepartmentDto>


@{
    ViewData["Title"] = "Index";
}

<a class="btn btn-primary" asp-controller="Department" asp-action="Create">Create New Department</a>
<!-- We want to display only when there is data -->
@if(Model.Count() > 0){
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(D => D.Code)</th>
                <th>@Html.DisplayNameFor(D => D.Name)</th>
                <th>@Html.DisplayNameFor(D => D.CreateAt)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.CreateAt</td>
                    <partial name="_ActionsButtonsPartialView" model="@department.Id.ToString()" />
                    @* name has to have the exactly same name of the partial view to work. *@
                </tr>
            }
        </tbody>
    </table>
}
else{
	<div class="mt-5 alert alert-info" role="alert">
		No data found
	</div>
}